<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
>
    <Panel
        class="sapUiSmallMargin "
        headerText="{i18n>volumeStatusTitle}"
        width="98.5%"
    >
        <VBox width="100%">
            <!-- ===== STATS CARDS ===== -->
            <HBox
                wrap="Wrap"
                width="100%"
                justifyContent="SpaceBetween"
                class="statsCardsRow"
            >
                <!-- Total Open Tasks -->
                <GenericTile
                    header="{i18n>totalOpenTasksText}"
                    frameType="OneByOne"
                    width="100%"
                    state="{= ${statsAnalyticsModel>/busy} ? 'Loading' : 'Loaded'}"
                >
                    <layoutData>
                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="1"
                            minWidth="14rem"
                        />
                    </layoutData>
                    <tileContent>
                        <TileContent
                            footer="{i18n>totalOpenTasksText}"
                            unit="{i18n>tasksUnit}"
                        >
                            <content>
                                <NumericContent
                                    value="{statsAnalyticsModel>/result/IsOpenCount}"
                                    icon="sap-icon://paste"
                                    valueColor="Good"
                                    indicator="None"
                                    withMargin="false"
                                    animateTextChange="true"
                                />
                            </content>
                        </TileContent>
                    </tileContent>
                </GenericTile>

                <!-- Completed This Month -->
                <GenericTile
                    header="{i18n>CompletedTasksThisMonthText}"
                    frameType="OneByOne"
                    width="100%"
                    state="{= ${statsAnalyticsModel>/busy} ? 'Loading' : 'Loaded'}"
                >
                    <layoutData>
                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="1"
                            minWidth="14rem"
                        />
                    </layoutData>
                    <tileContent>
                        <TileContent
                            footer="{i18n>CompletedTasksThisMonthText}"
                            unit="{i18n>tasksUnit}"
                        >
                            <content>
                                <NumericContent
                                    value="{statsAnalyticsModel>/result/IsCompletedThisMonth}"
                                    icon="sap-icon://task"
                                    valueColor="Good"
                                    indicator="None"
                                    withMargin="false"
                                    animateTextChange="true"
                                />
                            </content>
                        </TileContent>
                    </tileContent>
                </GenericTile>

                <!-- Overdue Tasks -->
                <GenericTile
                    header="{i18n>OverdueTasksText}"
                    frameType="OneByOne"
                    width="100%"
                    state="{= ${statsAnalyticsModel>/busy} ? 'Loading' : 'Loaded'}"
                >
                    <layoutData>
                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="1"
                            minWidth="14rem"
                        />
                    </layoutData>
                    <tileContent>
                        <TileContent
                            footer="{i18n>OverdueTasksText}"
                            unit="{i18n>tasksUnit}"
                        >
                            <content>
                                <NumericContent
                                    value="{statsAnalyticsModel>/result/IsOverdueCount}"
                                    icon="sap-icon://alert"
                                    valueColor="Error"
                                    indicator="Down"
                                    withMargin="false"
                                    animateTextChange="true"
                                />
                            </content>
                        </TileContent>
                    </tileContent>
                </GenericTile>

                <!-- Completion Rate -->
                <GenericTile
                    header="{i18n>CompletionRateText}"
                    frameType="OneByOne"
                    width="100%"
                    state="{= ${statsAnalyticsModel>/busy} ? 'Loading' : 'Loaded'}"
                >
                    <layoutData>
                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="1"
                            minWidth="14rem"
                        />
                    </layoutData>
                    <tileContent>
                        <TileContent
                            footer="{i18n>CompletionRateText}"
                            unit="%"
                        >
                            <content>
                                <NumericContent
                                    icon="sap-icon://pie-chart"
                                    value="{
                                        parts:[
                                            {path:'statsAnalyticsModel>/result/IsCompletedCount'},
                                            {path:'statsAnalyticsModel>/result/TaskCounter'}
                                        ],
                                        formatter:'.formatter.formatCompletionRate'
                                    }"
                                    valueColor="{
                                        parts:[
                                            {path:'statsAnalyticsModel>/result/IsCompletedCount'},
                                            {path:'statsAnalyticsModel>/result/TaskCounter'}
                                        ],
                                        formatter:'.formatter.formatCompletionRateColor'
                                    }"
                                    scale="%"
                                    withMargin="false"
                                    animateTextChange="true"
                                />
                            </content>
                        </TileContent>
                    </tileContent>
                </GenericTile>
            </HBox>

            <!-- ===== CHART AREA ===== -->
            <HBox
                width="100%"
                wrap="Wrap"
                justifyContent="SpaceBetween"
                class="sapUiTinyMarginTop"
                busy="{statsAnalyticsModel>/busy}"
            >
                <!-- STATUS DONUT -->
                <viz:VizFrame
                    class="sapUiSmallMargin"
                    vizType="donut"
                    width="100%"
                    height="400px"
                    vizProperties="{
                            title:{
                                visible:true,
                                text:'Status Distribution'
                            },
                            plotArea:{
                                dataLabel:{
                                    visible:true,
                                    type:'value'
                                },
                                showGap:true
                            }
                        }"
                >
                    <viz:layoutData>
                        <FlexItemData
                            growFactor="1"
                            minWidth="500px"
                        />
                    </viz:layoutData>
                    <viz:dataset>
                        <viz.data:FlattenedDataset
                            data="{
                                path:'statsAnalytics>/ZC_GSP26SAP02_WF_ANALYTICS',
                                parameters:{
                                    $select:'StatusCategory,TaskCounter'
                                }                                
                            }"
                        >
                            <viz.data:dimensions>
                                <viz.data:DimensionDefinition
                                    name="Status"
                                    value="{StatusCategory}"
                                />
                            </viz.data:dimensions>

                            <viz.data:measures>
                                <viz.data:MeasureDefinition
                                    name="Tasks"
                                    value="{TaskCounter}"
                                />
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>

                    <viz:feeds>
                        <viz.feeds:FeedItem
                            uid="color"
                            type="Dimension"
                            values="Status"
                        />
                        <viz.feeds:FeedItem
                            uid="size"
                            type="Measure"
                            values="Tasks"
                        />
                    </viz:feeds>
                </viz:VizFrame>

                <!-- PRIORITY BAR -->
                <viz:VizFrame
                    class="sapUiSmallMargin"
                    vizType="bar"
                    width="100%"
                    height="400px"
                    vizProperties="{
                        title:{
                            visible:true,
                            text:'Tasks in Processing by Priority'
                        },
                        plotArea:{
                            dataLabel:{
                                visible:true,
                                type:'value',
                                hideWhenOverlap:true
                            },
                            colorPalette:['#e60000','#f2c200','#7ed321'],
                            isScrollable:true
                        },
                        legend:{
                            visible:true
                        }
                    }"
                >
                    <viz:layoutData>
                        <FlexItemData
                            growFactor="1"
                            minWidth="500px"
                        />
                    </viz:layoutData>
                    <viz:dataset>
                        <viz.data:FlattenedDataset
                            data="{
                                path:'statsAnalytics>/ZC_GSP26SAP02_WF_ANALYTICS',
                                parameters:{
                                    $select:'PriorityLevel,TaskCounter'
                                }
                            }"
                        >
                            <viz.data:dimensions>
                                <viz.data:DimensionDefinition
                                    name="Priority"
                                    value="{PriorityLevel}"
                                />
                            </viz.data:dimensions>

                            <viz.data:measures>
                                <viz.data:MeasureDefinition
                                    name="Tasks"
                                    value="{TaskCounter}"
                                />
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>
                    <viz:feeds>
                        <viz.feeds:FeedItem
                            uid="valueAxis"
                            type="Measure"
                            values="Tasks"
                        />

                        <viz.feeds:FeedItem
                            uid="categoryAxis"
                            type="Dimension"
                            values="Priority"
                        />

                        <viz.feeds:FeedItem
                            uid="color"
                            type="Dimension"
                            values="Priority"
                        />
                    </viz:feeds>
                </viz:VizFrame>
            </HBox>
        </VBox>
    </Panel>
</core:FragmentDefinition>
