<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
>
    <Panel
        class="sapUiSmallMargin "
        headerText="{i18n>volumeStatusTitle}"
        width="98.5%"
    >
        <VBox width="100%">
            <!-- ===== STATS CARDS ===== -->
            <HBox
                wrap="Wrap"
                width="100%"
                justifyContent="SpaceBetween"
                class="statsCardsRow"
            >
                <!-- Total Open Tasks -->
                <HBox
                    class="statsCard statsCardBlue"
                    busy="{statsAnalyticsModel>/busy}"
                >
                    <core:Icon
                        src="sap-icon://paste"
                        class="statsCardIcon statsCardIconBlue"
                    />
                    <VBox class="statsCardContent">
                        <Text
                            text="{statsAnalyticsModel>/result/IsOpenCount}"
                            class="statsCardValue statsCardValueBlue"
                        />
                        <Text
                            text="{i18n>totalOpenTasksText}"
                            class="statsCardLabelGreen"
                        />
                    </VBox>
                </HBox>

                <!-- Completed This Month -->
                <HBox
                    class="statsCard statsCardGreen"
                    busy="{statsAnalyticsModel>/busy}"
                >
                    <core:Icon
                        src="sap-icon://task"
                        class="statsCardIcon statsCardIconGreen"
                    />
                    <VBox class="statsCardContent">
                        <Text
                            text="{statsAnalyticsModel>/result/IsCompletedThisMonth}"
                            class="statsCardValue statsCardValueGreen"
                        />
                        <Text text="{i18n>CompletedTasksThisMonthText}" />
                    </VBox>
                </HBox>

                <!-- Overdue Tasks -->
                <HBox
                    class="statsCard statsCardRed"
                    busy="{statsAnalyticsModel>/busy}"
                >
                    <core:Icon
                        src="sap-icon://alert"
                        class="statsCardIcon statsCardIconRed"
                    />
                    <VBox class="statsCardContent">
                        <Text
                            text="{statsAnalyticsModel>/result/IsOverdueCount}"
                            class="statsCardValue statsCardValueRed"
                        />
                        <Text text="{i18n>OverdueTasksText}" />
                    </VBox>
                </HBox>

                <!-- Completion Rate -->
                <HBox
                    class="statsCard statsCardYellow"
                    busy="{statsAnalyticsModel>/busy}"
                >
                    <core:Icon
                        src="sap-icon://pie-chart"
                        class="statsCardIcon statsCardIconYellow"
                    />
                    <VBox class="statsCardContent">
                        <Text
                            text="{
                                parts:[
                                    {path:'statsAnalyticsModel>/result/IsCompletedCount'},
                                    {path:'statsAnalyticsModel>/result/TaskCounter'}
                                ],
                                formatter:'.formatter.formatCompletionRate'
                            }%"
                            class="statsCardValue statsCardValueYellow"
                        />
                        <Text text="{i18n>CompletionRateText}" />
                    </VBox>
                </HBox>
            </HBox>

            <!-- ===== CHART AREA ===== -->
            <HBox
                width="100%"
                wrap="Wrap"
                justifyContent="SpaceBetween"
                class="sapUiTinyMarginTop"
            >
                <!-- STATUS DONUT -->
                <viz:VizFrame
                    class="sapUiSmallMargin"
                    vizType="donut"
                    width="100%"
                    height="400px"
                    vizProperties="{
                            title:{
                                visible:true,
                                text:'Status Distribution'
                            },
                            plotArea:{
                                dataLabel:{
                                    visible:true,
                                    type:'value'
                                },
                                showGap:true
                            }
                        }"
                >
                    <viz:layoutData>
                        <FlexItemData
                            growFactor="1"
                            minWidth="500px"
                        />
                    </viz:layoutData>
                    <viz:dataset>
                        <viz.data:FlattenedDataset
                            data="{
                                path:'statsAnalytics>/ZC_GSP26SAP02_WF_ANALYTICS',
                                parameters:{
                                    $select:'StatusCategory,TaskCounter'
                                }                                
                            }"
                        >
                            <viz.data:dimensions>
                                <viz.data:DimensionDefinition
                                    name="Status"
                                    value="{StatusCategory}"
                                />
                            </viz.data:dimensions>

                            <viz.data:measures>
                                <viz.data:MeasureDefinition
                                    name="Tasks"
                                    value="{TaskCounter}"
                                />
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>

                    <viz:feeds>
                        <viz.feeds:FeedItem
                            uid="color"
                            type="Dimension"
                            values="Status"
                        />
                        <viz.feeds:FeedItem
                            uid="size"
                            type="Measure"
                            values="Tasks"
                        />
                    </viz:feeds>
                </viz:VizFrame>

                <!-- PRIORITY BAR -->
                <viz:VizFrame
                    class="sapUiSmallMargin"
                    vizType="bar"
                    width="100%"
                    height="400px"
                    vizProperties="{
                        title:{
                            visible:true,
                            text:'Tasks in Processing by Priority'
                        },
                        plotArea:{
                            dataLabel:{
                                visible:true,
                                type:'value',
                                hideWhenOverlap:true
                            },
                            colorPalette:['#e60000','#f2c200','#7ed321'],
                            isScrollable:true
                        },
                        legend:{
                            visible:true
                        }
                    }"
                >
                    <viz:layoutData>
                        <FlexItemData
                            growFactor="1"
                            minWidth="500px"
                        />
                    </viz:layoutData>
                    <viz:dataset>
                        <viz.data:FlattenedDataset
                            data="{
                                path:'statsAnalytics>/ZC_GSP26SAP02_WF_ANALYTICS',
                                parameters:{
                                    $select:'PriorityLevel,TaskCounter'
                                }
                            }"
                        >
                            <viz.data:dimensions>
                                <viz.data:DimensionDefinition
                                    name="Priority"
                                    value="{PriorityLevel}"
                                />
                            </viz.data:dimensions>

                            <viz.data:measures>
                                <viz.data:MeasureDefinition
                                    name="Tasks"
                                    value="{TaskCounter}"
                                />
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>
                    <viz:feeds>
                        <viz.feeds:FeedItem
                            uid="valueAxis"
                            type="Measure"
                            values="Tasks"
                        />

                        <viz.feeds:FeedItem
                            uid="categoryAxis"
                            type="Dimension"
                            values="Priority"
                        />

                        <viz.feeds:FeedItem
                            uid="color"
                            type="Dimension"
                            values="Priority"
                        />
                    </viz:feeds>
                </viz:VizFrame>
            </HBox>
        </VBox>
    </Panel>
</core:FragmentDefinition>
