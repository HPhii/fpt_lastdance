<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Panel
        class="sapUiSmallMargin statsPanel"
        headerText="{i18n>userWorkloadTitle}"
        width="98.5%"
    >
        <FlexBox
            width="100%"
            direction="Column"
        >
            <!-- Group Column Chart -->
            <core:Fragment
                fragmentName="z.wf.zwfmanagement.view.fragments.analytics.userWorkload.groupColumnChart"
                type="XML"
            />

            <!-- Scatter Plot -->
            <core:Fragment
                fragmentName="z.wf.zwfmanagement.view.fragments.analytics.userWorkload.scatterChart"
                type="XML"
            />
        </FlexBox>
    </Panel>
</core:FragmentDefinition>
