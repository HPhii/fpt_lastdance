<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Table
        id="adminInboxUsersTable"
        busy="{adminInboxViewModel>/isUsersBusy}"
        visible="{adminInboxViewModel>/isUsersVisible}"
        items="{
            path: 'adminInboxViewModel>/users',
            sorter: {
                path: 'UniqueName', 
                descending: false 
            }
        }"
        itemPress=".onUserPress"
        sticky="ColumnHeaders,HeaderToolbar"
    >
        <headerToolbar>
            <OverflowToolbar width="100%">
                <Title
                    busy="{adminInboxViewModel>/isUsersBusy}"
                    text="{i18n>userTitle} ({adminInboxViewModel>/countTotal})"
                    level="H2"
                />
                <ToolbarSpacer />
                <SearchField
                    width="auto"
                    search=".onSearchUsers"
                    placeholder="{i18n>userInputPlaceholder}"
                    tooltip="{i18n>tooltipHeaderSearch}"
                />
                <Button
                    icon="sap-icon://sort"
                    press=".onSortUsers"
                    tooltip="{i18n>tooltipHeaderSort}"
                />
                <Button
                    icon="sap-icon://filter"
                    press=".onFilterUsers"
                    tooltip="{i18n>tooltipHeaderFilter}"
                />
            </OverflowToolbar>
        </headerToolbar>
        <columns>
            <Column>
                <Text text="{i18n>userUniqueName}" />
            </Column>
            <Column>
                <Text text="{i18n>userDisplayName}" />
            </Column>
            <Column>
                <Text text="{i18n>userAddress}" />
            </Column>
            <Column>
                <Text text="{i18n>userCompany}" />
            </Column>
            <Column>
                <Text text="{i18n>userDepartment}" />
            </Column>
            <Column>
                <Text text="{i18n>userEmail}" />
            </Column>
        </columns>
        <ColumnListItem type="Navigation">
            <cells>
                <Text text="{adminInboxViewModel>UniqueName}" />
                <Text text="{adminInboxViewModel>DisplayName}" />
                <Text
                    text="{= 
                        ${adminInboxViewModel>Address/Street} + ' ' + 
                        ${adminInboxViewModel>Address/StreetNumber} + ', ' + 
                        ${adminInboxViewModel>Address/City} + ', ' + 
                        ${adminInboxViewModel>Address/Country} 
                    }"
                />
                <Text text="{adminInboxViewModel>Company}" />
                <Text text="{adminInboxViewModel>Department}" />
                <Text text="{adminInboxViewModel>Email}" />
            </cells>
        </ColumnListItem>
    </Table>
</core:FragmentDefinition>
